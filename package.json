{
    "name": "@bryan-debaun/mcp-server",
    "version": "0.1.0",
    "description": "Extensible MCP server for VS Code Copilot with GitHub Issues tools",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "build": "prisma generate && pnpm run build:spec && tsc && pnpm run build:seed",
        "build:spec": "tsoa spec-and-routes && tsx scripts/fix-tsoa-imports.ts",
        "build:seed": "tsc prisma/seed.ts --ignoreConfig --outDir dist --module NodeNext --target ES2022 --moduleResolution NodeNext --esModuleInterop --allowSyntheticDefaultImports --resolveJsonModule --skipLibCheck",
        "dev": "tsc --watch",
        "start": "node dist/index.js",
        "start:http": "cross-env MCP_TRANSPORT=http node dist/index.js",
        "mcp-proxy": "tsx scripts/mcp-proxy.ts",
        "check-spotify": "tsx scripts/check-spotify.ts",
        "sql:parse": "tsx scripts/find-sql-error.ts prisma/migrations/20260220133827_embed_ratings_in_entities/migration.sql --dry-run",
        "sql:validate": "tsx scripts/find-sql-error.ts prisma/migrations/20260220133827_embed_ratings_in_entities/migration.sql --apply",
        "sql:exec": "tsx scripts/exec-sql-pg.ts",
        "bruno:sync": "pnpm run build:spec && tsx scripts/sync-bruno.ts",
        "bruno:smoke": "bru run tools/bruno/Ops --env prod",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -p tsconfig.test.json --noEmit",
        "lint": "biome check src test scripts prisma",
        "lint:fix": "biome check --write src test scripts prisma",
        "format": "biome format --write src test scripts prisma",
        "knip": "knip",
        "verify": "pnpm run lint && pnpm run typecheck",
        "prisma:dev": "prisma db push && prisma generate",
        "prisma:seed": "node dist/seed.js",
        "prisma:seed:dev": "tsx prisma/seed.ts",
        "prisma:generate": "prisma generate",
        "db:deploy": "prisma migrate deploy && node dist/seed.js",
        "db:snapshot": "tsx scripts/db-snapshot.ts",
        "logto:users": "tsx scripts/logto-test-users.ts",
        "env:pull": "doppler secrets download --no-file --format env > .env.local"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "vscode",
        "copilot",
        "github"
    ],
    "author": "bryan-debaun",
    "license": "MIT",
    "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
    "engines": {
        "node": ">=20.19.0",
        "pnpm": ">=11.0.0"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@octokit/graphql": "^9.0.3",
        "@octokit/rest": "^22.0.1",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "@prisma/config": "^7.9.1",
        "@sentry/node": "^10.69.0",
        "@tsoa/runtime": "^7.0.0-alpha.0",
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^4.18.2",
        "jose": "^6.2.5",
        "pg": "^8.22.0",
        "pino": "^10.3.1",
        "prisma": "^7.9.1",
        "prom-client": "^15.1.3",
        "swagger-ui-express": "^5.0.1",
        "tsoa": "^7.0.0-alpha.0",
        "ws": "^8.21.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.17",
        "@types/express-serve-static-core": "^4.19.8",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.13.3",
        "@types/pg": "^8.20.0",
        "@types/supertest": "^2.0.12",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/ws": "^8.18.1",
        "@types/yargs": "^17.0.35",
        "@usebruno/cli": "^3.4.2",
        "@vitest/coverage-v8": "^3.2.6",
        "cross-env": "^7.0.3",
        "knip": "^6.29.0",
        "pino-pretty": "^13.1.3",
        "supertest": "^6.3.3",
        "ts-node": "^10.9.1",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2",
        "vitest": "^3.2.4",
        "yargs": "^18.1.0"
    },
    "prisma": {
        "schema": "prisma/schema.prisma"
    }
}
