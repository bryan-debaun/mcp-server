}

example {
  name: 429 Response
  description: Quota exceeded
  
  request: {
    url: {{baseUrl}}/api/resumeDownloadRequests
    method: POST
    mode: json
    body:json: {
      {
        "reason": ""
      }
    }
  }
  
  response: {
    status: {
      code: 429
      text: Too Many Requests
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
